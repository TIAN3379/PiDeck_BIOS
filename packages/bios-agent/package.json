{
	"name": "bios-agent",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"description": "BIOS 专业开发知识 Pi Package：项目档案、任务、经验与证据的契约、只读工具与 Skills。",
	"keywords": ["pi-package"],
	"pi": {
		"extensions": ["./extensions/index.ts"],
		"skills": ["./skills"]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.1"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --test \"tests/*.test.mjs\"",
		"selfcheck": "node cli/selfcheck.mjs",
		"knowledge": "node cli/knowledge.mjs",
		"project": "node cli/project.mjs",
		"scenario:project": "node cli/project-scenario.mjs",
		"business": "node cli/business.mjs",
		"scenario:experience": "node cli/experience-scenario.mjs",
		"task": "node cli/task.mjs",
		"scenario:task": "node cli/task-scenario.mjs",
		"check:format": "biome format .",
		"format": "biome format --write ."
	}
}
